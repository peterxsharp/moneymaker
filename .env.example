# ==========================================================================
# Passive Income Hub / moneymaker — Environment variable template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=<PLACEHOLDER_postgresql_connection_string>

# --- AbacusAI (LLM API for script generation, briefs, calendars) ---
ABACUSAI_API_KEY=<PLACEHOLDER>

# --- NextAuth / Auth.js (session + JWT signing) ---
NEXTAUTH_SECRET=<PLACEHOLDER_random_32char_secret>
AUTH_SECRET=<PLACEHOLDER_random_32char_secret>
NEXTAUTH_URL=<PLACEHOLDER_https://your-domain.com>

# --- Access control (comma-separated allowlist of sign-in emails) ---
ALLOWED_EMAILS=<PLACEHOLDER_email1@example.com,email2@example.com>

# --- AWS S3 (video/thumbnail/voiceover asset storage) ---
AWS_PROFILE=<PLACEHOLDER_aws_profile_name>
AWS_REGION=<PLACEHOLDER_us-west-2>
AWS_BUCKET_NAME=<PLACEHOLDER_s3_bucket_name>
AWS_FOLDER_PREFIX=<PLACEHOLDER_folder_prefix/>
# If not using a shared AWS profile, provide explicit credentials instead:
# AWS_ACCESS_KEY_ID=<PLACEHOLDER>
# AWS_SECRET_ACCESS_KEY=<PLACEHOLDER>

# --- OpenAI (text-to-speech voiceover via tts-1) ---
OPENAI_API_KEY=<PLACEHOLDER>

# --- YouTube Data API v3 (Google OAuth2) ---
YOUTUBE_CLIENT_ID=<PLACEHOLDER_xxxxx.apps.googleusercontent.com>
YOUTUBE_CLIENT_SECRET=<PLACEHOLDER>

# --- Vimeo (cross-platform distribution) ---
VIMEO_ACCESS_TOKEN=<PLACEHOLDER>

# --- Dailymotion (cross-platform distribution, password-grant OAuth) ---
DAILYMOTION_API_KEY=<PLACEHOLDER>
DAILYMOTION_API_SECRET=<PLACEHOLDER>
DAILYMOTION_USERNAME=<PLACEHOLDER>
DAILYMOTION_PASSWORD=<PLACEHOLDER>
